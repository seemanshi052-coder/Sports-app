# ==============================================================================
# Sports Talent Platform Environment Configuration
# ==============================================================================

# Server & Runtime Configuration
PORT=3000
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Supabase Configuration (Single Source of Truth)
# ------------------------------------------------------------------------------
# Server & Client Supabase Endpoint URL (e.g. https://uehiijbiycuwmyivvruh.supabase.co)
SUPABASE_URL=

# Client-Side / Mobile Publishable Key (for client app and web frontend)
SUPABASE_PUBLISHABLE_KEY=

# Server-Side Supabase Secret Key (Backend API only - NEVER expose to client)
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (Server-Side Only)
# ------------------------------------------------------------------------------
# Connection string from Supabase Project Settings -> Database (Transaction/Session Pooler)
# e.g. postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Storage Bucket for Athlete Video Uploads
SUPABASE_STORAGE_BUCKET=assessment-videos
